# allwinner-h618.fragment — Allwinner H618: sun8i EMAC, mmc-sunxi, EHCI/OHCI USB, Panfrost + PRCM_PPU, sunxi display/rtc/thermal/pwm/ir
# Auto-derived from the original build.sh ensure_kernel_config_option lines.
# Merged on top of defconfig (+distro) by lib/kernel.sh; later fragments win.

CONFIG_DWMAC_SUN8I=y
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
CONFIG_SUN50I_H6_PRCM_PPU=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_SUN8I_THERMAL=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y
CONFIG_RC_CORE=y
CONFIG_IR_SUNXI=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BT=y
