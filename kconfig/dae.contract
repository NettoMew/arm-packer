# dae capability contract (daeuniverse/dae, eBPF transparent proxy).
#
# A contract is both a request and a gate: kernel.sh merges it right after the
# distro base and, once olddefconfig has resolved the .config, checks every line
# against the result. "=y" must be built in, "=m" may be a module or built in,
# "is not set" must stay off. A Kconfig dependency that cannot be met (pahole
# missing, so DEBUG_INFO_BTF falls away) fails the build instead of shipping a
# kernel dae cannot load into.
#
# Taken from vyos-rockchip overlay/.../config/73-dae.config (2026-09-16), proven
# there by loading dae's programs on a real board; keep the two in step.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NET_SCHED=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
CONFIG_NET_SCH_INGRESS=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_CLS_ACT=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_VETH=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SYSCTL=y
# Upstream dae compatibility baseline.
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
# Full DWARF is the input pahole turns into BTF; only BTF is needed at runtime.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_NONE is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
# Module BTF is not part of it: dae's CO-RE relocations read vmlinux types only
# (its tc programs see the UAPI __sk_buff), and modern.fragment leaves it off.
# arm-packer addition: on 6.7+ dae v2 puts its namespace on a netkit device pair
# and only falls back to veth ("compatibility mode") when the kernel lacks it.
CONFIG_NETKIT=y
