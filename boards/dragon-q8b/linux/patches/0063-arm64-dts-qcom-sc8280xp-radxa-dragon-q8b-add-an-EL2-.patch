 arch/arm64/boot/dts/qcom/Makefile             |  3 +-
 .../qcom/sc8280xp-radxa-dragon-q8b-el2.dtso   | 41 +++++++++++++++++++
 2 files changed, 43 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b-el2.dtso

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index c4f2d61..d9ac034 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -297,7 +297,8 @@ sc8280xp-microsoft-arcata-el2-dtbs	:= sc8280xp-microsoft-arcata.dtb sc8280xp-el2
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8280xp-microsoft-arcata.dtb sc8280xp-microsoft-arcata-el2.dtb
 sc8280xp-microsoft-blackrock-el2-dtbs	:= sc8280xp-microsoft-blackrock.dtb sc8280xp-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= sc8280xp-microsoft-blackrock.dtb sc8280xp-microsoft-blackrock-el2.dtb
-dtb-$(CONFIG_ARCH_QCOM)	+= sc8280xp-radxa-dragon-q8b.dtb
+sc8280xp-radxa-dragon-q8b-el2-dtbs	:= sc8280xp-radxa-dragon-q8b.dtb sc8280xp-radxa-dragon-q8b-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= sc8280xp-radxa-dragon-q8b.dtb sc8280xp-radxa-dragon-q8b-el2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sda660-inforce-ifc6560.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm450-lenovo-tbx605f.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm450-motorola-ali.dtb
diff --git a/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b-el2.dtso b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b-el2.dtso
new file mode 100644
index 0000000..9106d7a
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sc8280xp-radxa-dragon-q8b-el2.dtso
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Radxa Dragon Q8B at EL2.
+ *
+ * With /chosen/radxa,enable-kvm present and the "Hypervisor Override" setup
+ * option left at Auto, the board firmware starts the operating system at EL2
+ * instead of under its hypervisor, and applies the EL2 device tree changes
+ * (PCIe SMMU, GPU zap shader, SHM bridge owner) itself.
+ *
+ * At EL2 Linux cannot start the DSPs through the PAS interface. The board
+ * firmware (BIOS 260916 and later, "Remoteproc firmware preload" at its
+ * default, Auto) starts them before ExitBootServices(), and Linux attaches
+ * to them. Iris cannot go through PAS either; with a "video-firmware" node
+ * the driver loads and starts its firmware itself.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+&{/chosen} {
+	radxa,enable-kvm = <1>;
+};
+
+/* The EL2 virtual timer, which VHE uses, next to the four EL1 ones. */
+&{/timer} {
+	interrupt-parent = <&intc>;
+	interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
+		     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
+		     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
+		     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>,
+		     <GIC_PPI 12 IRQ_TYPE_LEVEL_LOW>;
+};
+
+&iris {
+	/* The firmware's own stream: Linux loads and starts it without TZ */
+	video-firmware {
+		iommus = <&apps_smmu 0x2a02 0x400>;
+	};
+};
