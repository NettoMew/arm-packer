# boards/dragon-q8b/kernel.fragment — Radxa Dragon Q8B board devices on top of
# kconfig/qcom-sc8280xp.fragment.

# 2× 2.5 GbE: Toshiba TC9564 (QPS615) PCIe switch with integrated XGMAC + QCA8081
# PHYs. The switch's power control is built in so it is up before PCIe probes,
# and so is the I2C EEPROM holding the two MAC addresses, which the power
# control waits for: as a module it came only with udev, and PCIe was deferred
# and retried until then.
CONFIG_PCI_PWRCTRL_TC9563=y
CONFIG_EEPROM_AT24=y
CONFIG_STMMAC_ETH=y
# The three TC956X symbols come from the board's patch series (linux/patches/).
CONFIG_TOSHIBA_TC956X_PCI=m
CONFIG_DWMAC_TC956X=m
CONFIG_GPIO_TC956X=m
CONFIG_QCA808X_PHY=y
CONFIG_AT803X_PHY=y

# HDMI: DP → Chrontel CH7218A (a simple-bridge compatible) → HDMI connector.
CONFIG_DRM_SIMPLE_BRIDGE=y
CONFIG_DRM_DISPLAY_CONNECTOR=y

# Audio codec: WCD9385 over SoundWire.
CONFIG_SND_SOC_WCD938X_SDW=m
CONFIG_SND_SOC_WSA883X=m

# Battery-backed RTC (st,m41t11 on i2c12).
CONFIG_RTC_DRV_M41T80=y

# The fan is run by Radxa's service on the ADSP; this driver (from the board's
# patch series) exposes it and the service's sensors through hwmon. udev loads
# it when the ADSP opens the RADXA_SVC_ADSP_APPS channel.
CONFIG_RADXA_SVC_GLINK=m

# No QTEE driver: this firmware's QTEE answers no object invocation (at EL1 the
# version query comes back 0.0.0, at EL2 the call fails with -EINVAL), and
# nothing in the image talks to it.
# CONFIG_QCOMTEE is not set
