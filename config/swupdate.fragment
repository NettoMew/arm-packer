# Offline, signed updates only. No daemon, downloader or raw block handlers.
CONFIG_SCRIPTS=y
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/arm-packer/hwrevision"
CONFIG_DEFAULT_CONFIG_FILE="/etc/arm-packer/swupdate.cfg"
CONFIG_LIBCONFIG=y
CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_HASH_VERIFY=y
CONFIG_SIGNED_IMAGES=y
CONFIG_SIGALG_RSAPSS=y
CONFIG_ARCHIVE=y
CONFIG_SHELLSCRIPTHANDLER=y
CONFIG_BOOTLOADER_NONE=y
CONFIG_BOOTLOADER_DEFAULT_NONE=y
CONFIG_BOOTLOADER_STATIC_LINKED=y
